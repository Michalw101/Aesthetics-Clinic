# העתיקי לקובץ .env והחליפי בערכים האמיתיים (אל תעלי את .env ל-GitHub)

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# anon/public key — לאימות JWT של משתמשים
SUPABASE_KEY=your_supabase_anon_key
# service_role key — רק בשרת! נדרש ל-endpoints אדמין (עוקף RLS, גישה ל-auth.users)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google AI Studio → API Keys (רק בשרת, לא בפרונט)
GEMINI_API_KEY=your_gemini_api_key

# אופציונלי — ברירת מחדל: gemini-2.5-flash (בלי הקידומת models/)
# GEMINI_MODEL=gemini-2.5-flash
