# העתיקי לקובץ .env והחליפי בערכים האמיתיים (אל תעלי את .env ל-GitHub)

# Supabase — Project Settings → API
# השתמשי ב-anon key לפיתוח; לפרודקשן שקלי service_role רק בשרת עם RLS מתאים
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Google AI Studio → API Keys (רק בשרת, לא בפרונט)
GEMINI_API_KEY=your_gemini_api_key

# אופציונלי — ברירת מחדל: gemini-2.5-flash (בלי הקידומת models/)
# GEMINI_MODEL=gemini-2.5-flash
